// Prisma schema — korter.ge deal-alerts app (Task 1: data layer)
// SQLite + prisma-client-js. Arrays are stored as JSON strings
// (Prisma primitive lists are not supported on SQLite).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A user-defined price watcher over korter.ge listings.
model Alert {
  id          String   @id @default(cuid())
  name        String
  minPrice    Int?
  maxPrice    Int?
  cityId      Int      @default(1) // korter geo id (1=Tbilisi, 2=Batumi)
  districtIds String   @default("[]") // JSON string array of korter district ids
  roomCounts  String   @default("[]") // JSON string array of room counts
  minArea     Float?
  maxArea     Float?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notifications NotificationRecord[]
}

// Snapshot of every korter listing we have ever seen, deduped on objectId.
model Listing {
  objectId     Int      @id
  price        Float
  currency     String   @default("USD")
  area         Float
  roomCount    Int
  actualizeTime DateTime
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  lastPrice    Float
  minPriceSeen Float
  priceDrops   Int      @default(0)
  cityId       Int
  districtId   Int?
  districtName String?
  address      String?
  buildingName String?
  lat          Float?
  lng          Float?
  floor        Int?
  floorCount   Int?
  image        String?
  link         String
  ppsm         Float
  isSold       Boolean  @default(false)
  raw          String // full source JSON stringified

  notifications NotificationRecord[]

  @@index([cityId, districtId])
  @@index([actualizeTime])
}

// One row per generated notification (in-app feed + scanner dedup).
model NotificationRecord {
  id            String    @id @default(cuid())
  alertId       String?
  objectId      Int
  kind          String // "NEW" | "PRICE_DROP" | "BUMP"
  price         Float
  previousPrice Float?
  title         String
  createdAt     DateTime  @default(now())
  readAt        DateTime?

  alert   Alert?  @relation(fields: [alertId], references: [id], onDelete: SetNull)
  listing Listing @relation(fields: [objectId], references: [objectId], onDelete: Cascade)

  @@index([createdAt])
  @@index([alertId, readAt])
}

// Rolling ppsm percentiles per district (shrinkage target for deal scores).
model DistrictStat {
  id          String   @id @default(cuid())
  cityId      Int
  districtId  Int?
  sampleCount Int
  p10         Float
  p25         Float
  p50         Float
  updatedAt   DateTime @updatedAt

  @@unique([cityId, districtId])
}

// Price-tracking snapshot for non-korter sources (ss.ge / myhome.ge),
// keyed "provider:remoteId". Written on every offer-page live sync so
// min-price and drop counts persist across views.
model RemoteListing {
  id           String   @id // "ss:25954411" | "myhome:26042136"
  provider     String // "ss" | "myhome"
  remoteId     String
  title        String
  priceUsd     Float
  lastPriceUsd Float
  minPriceUsd  Float
  priceDrops   Int      @default(0)
  area         Float
  roomCount    Int
  ppsmUsd      Float
  districtName String?
  cityName     String?
  sourceUrl    String
  image        String?
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  raw          String

  @@index([provider, lastSeenAt])
}

// ---------------------------------------------------------------------------
// Local ads — first-party owner listings (no external scraping involved)
// ---------------------------------------------------------------------------

// Registered user. Passwords are scrypt-hashed; apiToken is the SHA-256 of
// the token handed out at signup/login (the raw token is never stored).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  apiTokenHash String   @unique
  createdAt    DateTime @default(now())

  listings    LocalListing[]
  tgChatId    String?  @unique
  tgUsername  String?
  tgPairedAt  DateTime?
  tgPairCode  String?
  tgPairCodeExpiresAt DateTime?

  @@index([tgChatId])
}

// An owner-published apartment. Photos are stored as JSON array of
// data-URIs (client-side compressed, ≤8 photos) or absolute URLs.
model LocalListing {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  deal         String   @default("buy") // "buy" | "rent"
  title        String
  description  String   @default("")
  priceUsd     Float
  area         Float
  roomCount    Int      @default(0)
  bedrooms     Int?
  bathrooms    Int?
  floor        Int?
  floorCount   Int?
  condition    String? // "new" | "renovated" | "old" | "under_construction"
  furnished    String? // "yes" | "no" | "partial"
  cityName     String   @default("Tbilisi")
  districtName String
  address      String?
  lat          Float?
  lng          Float?
  photos       String   @default("[]") // JSON string array
  contactName  String
  contactPhone String

  status       String   @default("active") // "active" | "paused"
  views        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  interests Interest[]

  @@index([status, deal, cityName])
  @@index([ownerId, createdAt])
}

// A lead captured from the "I'm interested" button on a local ad.
model Interest {
  id        String   @id @default(cuid())
  listingId String
  listing   LocalListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  message   String?
  createdAt DateTime @default(now())
  readAt    DateTime?

  @@index([listingId, createdAt])
}
